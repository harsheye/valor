import { Slider, Button } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "Valor Player";
    min-width: 900px;
    min-height: 560px;
    background: #000000;

    in-out property <string> media_title: "Valor - No Media Loaded";
    in-out property <string> time_display: "00:00 / 00:00";
    in-out property <float> progress: 0.0;
    in-out property <bool> is_playing: false;
    in-out property <float> volume: 1.0;
    in-out property <string> audio_track_label: "Default (WASAPI)";
    in-out property <string> sub_track_label: "Off";
    in-out property <string> active_subtitle_text: "";
    in-out property <bool> show_recent_panel: false;
    in-out property <string> speed_label: "1.0x";

    callback toggle_play();
    callback open_file();
    callback seek(float);
    callback change_volume(float);
    callback toggle_mute();
    callback step_forward();
    callback step_backward();
    callback toggle_audio_menu();
    callback toggle_sub_menu();
    callback toggle_speed();
    callback toggle_recent();

    forward-focus: key_handler;
    key_handler := FocusScope {
        key-pressed(event) => {
            if (event.text == " ") {
                root.toggle_play();
                return accept;
            }
            if (event.text == "m" || event.text == "M") {
                root.toggle_mute();
                return accept;
            }
            if (event.text == "s" || event.text == "S") {
                root.toggle_sub_menu();
                return accept;
            }
            if (event.text == "b" || event.text == "B") {
                root.toggle_audio_menu();
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.step_forward();
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.step_backward();
                return accept;
            }
            return reject;
        }
    }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Top Navigation Bar
        Rectangle {
            height: 48px;
            background: #0a0a0c;
            border-width: 1px;
            border-color: #1a1a22;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;

                // Logo & Media Title
                HorizontalLayout {
                    spacing: 14px;
                    alignment: start;

                    Text {
                        text: "VALOR";
                        color: #e11d2e;
                        font-size: 16px;
                        font-weight: 800;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.media_title;
                        color: #ffffff;
                        font-size: 13px;
                        font-weight: 500;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }

                // Action Buttons (History + Open File)
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    // History Button
                    Rectangle {
                        width: 76px;
                        height: 30px;
                        background: hist-area.has-hover ? #242430 : #14141c;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #262634;

                        Text {
                            text: "History";
                            color: #d4d4d8;
                            font-size: 11px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        hist-area := TouchArea {
                            clicked => { root.toggle_recent(); }
                        }
                    }

                    // Open File Button
                    Rectangle {
                        width: 90px;
                        height: 30px;
                        background: open-area.has-hover ? #e11d2e : #1c1c26;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #2c2c3e;

                        Text {
                            text: "+ Open File";
                            color: #ffffff;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        open-area := TouchArea {
                            clicked => { root.open_file(); }
                        }
                    }
                }
            }
        }

        // Center Viewport & Subtitle Surface
        Rectangle {
            background: #000000;

            // Empty state placeholder
            if media_title == "Valor - No Media Loaded": Rectangle {
                VerticalLayout {
                    alignment: center;
                    spacing: 16px;

                    Text {
                        text: "Drag and drop media here or click Open File";
                        color: #71717a;
                        font-size: 15px;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "Pure Rust Native Engine with Symphonia Demuxer & WASAPI Audio";
                        color: #52525b;
                        font-size: 12px;
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;

                        Rectangle {
                            height: 24px;
                            background: #14141c;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text { text: "Space: Play/Pause"; color: #888; font-size: 11px; vertical-alignment: center; }
                            }
                        }
                        Rectangle {
                            height: 24px;
                            background: #14141c;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text { text: "←/→: Seek ±5s"; color: #888; font-size: 11px; vertical-alignment: center; }
                            }
                        }
                        Rectangle {
                            height: 24px;
                            background: #14141c;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text { text: "M: Mute"; color: #888; font-size: 11px; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }

            // Real-Time Subtitle Text Overlay
            if active_subtitle_text != "": Rectangle {
                y: parent.height - 48px;
                x: 32px;
                width: parent.width - 64px;

                HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        background: rgba(0, 0, 0, 0.75);
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 4px;
                            padding-bottom: 4px;

                            Text {
                                text: root.active_subtitle_text;
                                color: #ffffff;
                                font-size: 18px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Bottom Playback Controls Bar
        Rectangle {
            height: 68px;
            background: #0a0a0c;
            border-width: 1px;
            border-color: #1a1a22;

            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 6px;
                padding-bottom: 8px;
                spacing: 6px;

                // Scrub / Seekbar
                HorizontalLayout {
                    spacing: 8px;

                    Slider {
                        minimum: 0.0;
                        maximum: 1.0;
                        value: root.progress;
                        changed(val) => { root.seek(val); }
                    }
                }

                // Controls Row
                HorizontalLayout {
                    alignment: space-between;

                    // Play/Pause, Step & Time
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        // Play/Pause Button
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            background: play-area.has-hover ? #e11d2e : #1c1c24;
                            border-radius: 16px;

                            Text {
                                text: root.is_playing ? "❚❚" : "▶";
                                color: #ffffff;
                                font-size: 13px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            play-area := TouchArea {
                                clicked => { root.toggle_play(); }
                            }
                        }

                        // Step Backward -5s
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            background: bwd-area.has-hover ? #282834 : transparent;
                            border-radius: 14px;

                            Text {
                                text: "↺ 5";
                                color: #a1a1aa;
                                font-size: 10px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            bwd-area := TouchArea {
                                clicked => { root.step_backward(); }
                            }
                        }

                        // Step Forward +5s
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            background: fwd-area.has-hover ? #282834 : transparent;
                            border-radius: 14px;

                            Text {
                                text: "5 ↻";
                                color: #a1a1aa;
                                font-size: 10px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            fwd-area := TouchArea {
                                clicked => { root.step_forward(); }
                            }
                        }

                        // Time Display
                        Text {
                            text: root.time_display;
                            color: #a1a1aa;
                            font-size: 12px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                    }

                    // Right Controls: Speed, Audio, Subtitles, Volume
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: end;

                        // Playback Speed Toggle
                        Rectangle {
                            height: 26px;
                            background: #14141c;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #262632;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: root.speed_label;
                                    color: #a1a1aa;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }

                            TouchArea {
                                clicked => { root.toggle_speed(); }
                            }
                        }

                        // Audio Track Chip
                        Rectangle {
                            height: 26px;
                            background: #14141c;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #262632;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;

                                Text {
                                    text: "Audio: " + root.audio_track_label;
                                    color: #d4d4d8;
                                    font-size: 11px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                            }

                            TouchArea {
                                clicked => { root.toggle_audio_menu(); }
                            }
                        }

                        // Subtitle Track Chip
                        Rectangle {
                            height: 26px;
                            background: #14141c;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #262632;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;

                                Text {
                                    text: "Subs: " + root.sub_track_label;
                                    color: #d4d4d8;
                                    font-size: 11px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                            }

                            TouchArea {
                                clicked => { root.toggle_sub_menu(); }
                            }
                        }

                        // Mute / Unmute Button
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            background: mute-area.has-hover ? #282834 : #14141c;
                            border-radius: 14px;

                            Text {
                                text: root.volume > 0.0 ? "🔊" : "🔇";
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            mute-area := TouchArea {
                                clicked => { root.toggle_mute(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
