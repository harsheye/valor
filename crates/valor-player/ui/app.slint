import { Slider, Button, ScrollView } from "std-widgets.slint";

export struct TrackItem {
    id: string,
    name: string,
    badge: string,
    is_active: bool,
}

export struct HistoryItem {
    id: string,
    title: string,
    time_str: string,
    progress: float,
}

export component MainWindow inherits Window {
    title: "Valor Player";
    min-width: 960px;
    min-height: 600px;
    background: #000000;

    in-out property <string> media_title: "Valor - No Media Loaded";
    in-out property <string> time_display: "00:00 / 00:00";
    in-out property <float> progress: 0.0;
    in-out property <bool> is_playing: false;
    in-out property <float> volume: 1.0;
    in-out property <string> audio_track_label: "Default (WASAPI)";
    in-out property <string> sub_track_label: "Off";
    in-out property <string> active_subtitle_text: "";
    in-out property <string> speed_label: "1.0x";

    // --- 3 PLAYBACK MODES: "local" (Legacy), "remote" (Remote), "embed" (Embed) ---
    in-out property <string> player_mode: "local";

    // Remote Player properties
    in-out property <string> remote_url: "http://localhost:8080/api/stream";
    in-out property <string> remote_status: "Disconnected";
    in-out property <bool> is_remote_connected: false;

    // Embed Player properties & settings (Overlay timeout + Hide Overlay)
    in-out property <int> overlay_timeout_secs: 3;
    in-out property <bool> hide_overlay: false;
    in-out property <bool> show_embed_settings: false;
    in-out property <string> embed_query_url: "http://localhost:8080/embed?overlayTimeout=3000&hideOverlay=false";

    // Modals / Panels
    in-out property <bool> show_audio_sub_popover: false;
    in-out property <bool> show_recent_panel: false;
    in-out property <bool> is_folded: true;

    // Track state (Mutually exclusive selection, deduplicated)
    in-out property <[TrackItem]> audio_tracks: [];
    in-out property <[TrackItem]> sub_tracks: [];
    in-out property <bool> is_sub_off: true;

    // Subtitle Customization
    in-out property <int> sub_font_size: 20;
    in-out property <string> sub_color: "#ffffff";
    in-out property <float> sub_delay: 0.0;
    in-out property <string> sub_delay_label: "0.0s";

    // Recent History
    in-out property <[HistoryItem]> history_items: [];

    // Callbacks
    callback toggle_play();
    callback open_file();
    callback seek(float);
    callback change_volume(float);
    callback toggle_mute();
    callback step_forward();
    callback step_backward();
    callback toggle_audio_menu();
    callback toggle_sub_menu();
    callback toggle_speed();
    callback toggle_recent();
    callback close_popovers();

    // 3 Player Mode callbacks
    callback switch_mode(string);
    callback connect_remote(string);
    callback toggle_embed_settings();
    callback set_overlay_timeout(int);
    callback toggle_hide_overlay();

    // Track callbacks
    callback select_audio_track(string);
    callback select_sub_track(string);
    callback set_sub_off();
    callback add_audio_file();
    callback add_sub_file();
    callback toggle_fold();

    // Subtitle style callbacks
    callback set_sub_font_size(int);
    callback set_sub_color(string);
    callback adjust_sub_delay(float);

    // History callback
    callback play_history_item(string);

    forward-focus: key_handler;
    key_handler := FocusScope {
        key-pressed(event) => {
            if (event.text == " ") {
                root.toggle_play();
                return accept;
            }
            if (event.text == "m" || event.text == "M") {
                root.toggle_mute();
                return accept;
            }
            if (event.text == "s" || event.text == "S") {
                root.toggle_sub_menu();
                return accept;
            }
            if (event.text == "b" || event.text == "B") {
                root.toggle_audio_menu();
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.step_forward();
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.step_backward();
                return accept;
            }
            if (event.text == Key.Escape) {
                root.close_popovers();
                return accept;
            }
            return reject;
        }
    }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Top Navigation Bar
        Rectangle {
            height: 52px;
            background: #0a0a0e;
            border-width: 1px;
            border-color: #1a1a24;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;

                // Brand & Title
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Text {
                        text: "VALOR";
                        color: #e11d2e;
                        font-size: 16px;
                        font-weight: 800;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.media_title;
                        color: #ffffff;
                        font-size: 13px;
                        font-weight: 500;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }

                // 3 Players Segment Switcher (Local / Remote / Embed)
                HorizontalLayout {
                    spacing: 4px;
                    alignment: center;

                    // 1. Local (Legacy) Player
                    Rectangle {
                        height: 28px;
                        background: root.player_mode == "local" ? #e11d2e : #14141c;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: root.player_mode == "local" ? #e11d2e : #262634;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            Text {
                                text: "Local Player";
                                color: root.player_mode == "local" ? #ffffff : #a1a1aa;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea { clicked => { root.switch_mode("local"); } }
                    }

                    // 2. Remote Player
                    Rectangle {
                        height: 28px;
                        background: root.player_mode == "remote" ? #2563eb : #14141c;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: root.player_mode == "remote" ? #3b82f6 : #262634;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            Text {
                                text: "Remote Player";
                                color: root.player_mode == "remote" ? #ffffff : #a1a1aa;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea { clicked => { root.switch_mode("remote"); } }
                    }

                    // 3. Embed Player
                    Rectangle {
                        height: 28px;
                        background: root.player_mode == "embed" ? #7c3aed : #14141c;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: root.player_mode == "embed" ? #8b5cf6 : #262634;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            Text {
                                text: "Embed Player";
                                color: root.player_mode == "embed" ? #ffffff : #a1a1aa;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea { clicked => { root.switch_mode("embed"); } }
                    }
                }

                // Action Buttons
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    // History Button
                    Rectangle {
                        width: 76px;
                        height: 30px;
                        background: hist-area.has-hover ? #242430 : (root.show_recent_panel ? #2a2a3c : #14141c);
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: root.show_recent_panel ? #e11d2e : #262634;

                        Text {
                            text: "History";
                            color: #d4d4d8;
                            font-size: 11px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        hist-area := TouchArea {
                            clicked => { root.toggle_recent(); }
                        }
                    }

                    // Open File Button (Local)
                    if root.player_mode == "local": Rectangle {
                        width: 92px;
                        height: 30px;
                        background: open-area.has-hover ? #e11d2e : #1c1c26;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #2c2c3e;

                        Text {
                            text: "+ Open File";
                            color: #ffffff;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        open-area := TouchArea {
                            clicked => { root.open_file(); }
                        }
                    }

                    // Embed Settings Button (Embed Mode)
                    if root.player_mode == "embed": Rectangle {
                        width: 110px;
                        height: 30px;
                        background: embed-btn-area.has-hover ? #6d28d9 : #5b21b6;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #7c3aed;

                        Text {
                            text: "⚙ Embed Setup";
                            color: #ffffff;
                            font-size: 11px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        embed-btn-area := TouchArea {
                            clicked => { root.toggle_embed_settings(); }
                        }
                    }
                }
            }
        }

        // Subheader Bar: Remote Player Stream URL Connection
        if root.player_mode == "remote": Rectangle {
            height: 38px;
            background: #0f1522;
            border-width: 1px;
            border-color: #1e293b;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Remote Stream:";
                        color: #94a3b8;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 440px;
                        height: 26px;
                        background: #090d16;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #1e293b;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: root.remote_url;
                                color: #38bdf8;
                                font-size: 11px;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        width: 90px;
                        height: 26px;
                        background: rem-conn.has-hover ? #1d4ed8 : #2563eb;
                        border-radius: 4px;

                        Text {
                            text: "▶ Connect";
                            color: #ffffff;
                            font-size: 11px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        rem-conn := TouchArea {
                            clicked => { root.connect_remote(root.remote_url); }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: end;

                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: root.is_remote_connected ? #22c55e : #ef4444;
                        y: 15px;
                    }

                    Text {
                        text: root.remote_status;
                        color: root.is_remote_connected ? #86efac : #f87171;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Subheader Bar: Embed Mode Indicator & Overlay Status
        if root.player_mode == "embed": Rectangle {
            height: 34px;
            background: #170d2a;
            border-width: 1px;
            border-color: #3b1d64;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Embed Player Mode Active";
                        color: #c4b5fd;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "• Inactivity Timeout: " + root.overlay_timeout_secs + "s";
                        color: #a78bfa;
                        font-size: 11px;
                        vertical-alignment: center;
                    }

                    if root.hide_overlay: Text {
                        text: "• Overlay: HIDDEN IN QUERY";
                        color: #f43f5e;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "Embed Protocol Active (PostMessage + WS)";
                    color: #8b5cf6;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }
        }

        // Center Viewport, Overlay, Subtitles & Popovers
        Rectangle {
            background: #000000;

            // Empty state placeholder
            if media_title == "Valor - No Media Loaded": Rectangle {
                VerticalLayout {
                    alignment: center;
                    spacing: 16px;

                    Text {
                        text: root.player_mode == "local" ? "Local Player Mode: Open file or drag media here" :
                              (root.player_mode == "remote" ? "Remote Player Mode: Connect to Valor Remote Server" :
                               "Embed Player Mode: Embed Query & Minimalist Player Active");
                        color: #71717a;
                        font-size: 15px;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "Pure Rust 3-in-1 Architecture: Symphonia Engine + Axum HTTP Streaming + Embed Protocol";
                        color: #52525b;
                        font-size: 12px;
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;

                        Rectangle {
                            height: 24px;
                            background: #14141c;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text { text: "Space: Play/Pause"; color: #888; font-size: 11px; vertical-alignment: center; }
                            }
                        }
                        Rectangle {
                            height: 24px;
                            background: #14141c;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text { text: "←/→: Seek ±5s"; color: #888; font-size: 11px; vertical-alignment: center; }
                            }
                        }
                        Rectangle {
                            height: 24px;
                            background: #14141c;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text { text: "S / B: Audio & Subs"; color: #888; font-size: 11px; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }

            // Real-Time Subtitle Text Overlay
            if active_subtitle_text != "": Rectangle {
                y: parent.height - 56px;
                x: 32px;
                width: parent.width - 64px;

                HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        background: rgba(0, 0, 0, 0.78);
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 6px;
                            padding-bottom: 6px;

                            Text {
                                text: root.active_subtitle_text;
                                color: root.sub_color == "#ffffff" ? #ffffff : (root.sub_color == "#fef08a" ? #fef08a : #67e8f9);
                                font-size: root.sub_font_size * 1px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // Backdrop click handler to dismiss popovers
            if show_audio_sub_popover || show_recent_panel || show_embed_settings: TouchArea {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                clicked => {
                    root.close_popovers();
                }
            }

            // --- EMBED SETTINGS DRAWER / POPOVER ---
            if show_embed_settings: Rectangle {
                x: parent.width - 440px;
                y: 12px;
                width: 420px;
                height: 380px;
                background: #110924;
                border-radius: 12px;
                border-width: 1px;
                border-color: #3b1d64;

                VerticalLayout {
                    padding: 18px;
                    spacing: 14px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "EMBED PLAYER SETTINGS";
                            color: #c4b5fd;
                            font-size: 12px;
                            font-weight: 800;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 22px;
                            height: 22px;
                            background: transparent;
                            Text { text: "✕"; color: #94a3b8; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.close_popovers(); } }
                        }
                    }

                    // Setting 1: Overlay Inactivity Timeout
                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "Overlay Inactivity Timer (Time until overlay hides):";
                            color: #e2e8f0;
                            font-size: 11px;
                            font-weight: 600;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            Rectangle {
                                width: 50px;
                                height: 26px;
                                background: root.overlay_timeout_secs == 1 ? #7c3aed : #1e1338;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: root.overlay_timeout_secs == 1 ? #a78bfa : #37235a;
                                Text { text: "1s"; color: #fff; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.set_overlay_timeout(1); } }
                            }
                            Rectangle {
                                width: 50px;
                                height: 26px;
                                background: root.overlay_timeout_secs == 3 ? #7c3aed : #1e1338;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: root.overlay_timeout_secs == 3 ? #a78bfa : #37235a;
                                Text { text: "3s"; color: #fff; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.set_overlay_timeout(3); } }
                            }
                            Rectangle {
                                width: 50px;
                                height: 26px;
                                background: root.overlay_timeout_secs == 5 ? #7c3aed : #1e1338;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: root.overlay_timeout_secs == 5 ? #a78bfa : #37235a;
                                Text { text: "5s"; color: #fff; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.set_overlay_timeout(5); } }
                            }
                            Rectangle {
                                width: 50px;
                                height: 26px;
                                background: root.overlay_timeout_secs == 10 ? #7c3aed : #1e1338;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: root.overlay_timeout_secs == 10 ? #a78bfa : #37235a;
                                Text { text: "10s"; color: #fff; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.set_overlay_timeout(10); } }
                            }
                        }
                    }

                    // Setting 2: Allow Overlay to be Hidden in Embed Query
                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "Embed Query Overlay Visibility:";
                            color: #e2e8f0;
                            font-size: 11px;
                            font-weight: 600;
                        }

                        Rectangle {
                            height: 32px;
                            background: root.hide_overlay ? #be123c : #1e1338;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: root.hide_overlay ? #f43f5e : #37235a;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                alignment: space-between;

                                Text {
                                    text: root.hide_overlay ? "Overlay Hidden Completely (hideOverlay=true)" : "Normal Overlay with Timer";
                                    color: #ffffff;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: root.hide_overlay ? "HIDDEN" : "VISIBLE";
                                    color: root.hide_overlay ? #fecdd3 : #a78bfa;
                                    font-size: 10px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            TouchArea { clicked => { root.toggle_hide_overlay(); } }
                        }
                    }

                    // Setting 3: Live Embed Query URL Output
                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "Generated Embed URL (with query params):";
                            color: #c4b5fd;
                            font-size: 11px;
                            font-weight: 600;
                        }

                        Rectangle {
                            height: 48px;
                            background: #090514;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #3b1d64;

                            VerticalLayout {
                                padding: 6px;
                                Text {
                                    text: root.embed_query_url;
                                    color: #a78bfa;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }

            // --- AUDIO & SUBTITLES POPOVER PANEL ---
            if show_audio_sub_popover: Rectangle {
                x: parent.width - 480px;
                y: parent.height - (root.is_folded ? 240px : 350px);
                width: 460px;
                height: root.is_folded ? 230px : 340px;
                background: #10141d;
                border-radius: 12px;
                border-width: 1px;
                border-color: #1f293d;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    // Header row: AUDIO section
                    VerticalLayout {
                        spacing: 8px;

                        HorizontalLayout {
                            alignment: space-between;

                            Text {
                                text: "AUDIO";
                                color: #8e9cb0;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "Single Active Selection";
                                color: #475569;
                                font-size: 10px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }

                        // Audio Chips Row
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            for track in root.audio_tracks: Rectangle {
                                height: 28px;
                                background: track.is_active ? #1e293b : (aud-item-touch.has-hover ? #1c2331 : #141923);
                                border-width: 1px;
                                border-color: track.is_active ? #3b82f6 : #263043;
                                border-radius: 6px;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 6px;
                                    alignment: center;

                                    Text {
                                        text: track.name;
                                        color: track.is_active ? #ffffff : #cbd5e1;
                                        font-size: 11px;
                                        font-weight: track.is_active ? 700 : 500;
                                        vertical-alignment: center;
                                    }

                                    if track.is_active: Text {
                                        text: "✓";
                                        color: #3b82f6;
                                        font-size: 11px;
                                        font-weight: 800;
                                        vertical-alignment: center;
                                    }
                                }

                                aud-item-touch := TouchArea {
                                    clicked => {
                                        root.select_audio_track(track.id);
                                    }
                                }
                            }

                            // + File Button (Add External Audio)
                            Rectangle {
                                width: 56px;
                                height: 28px;
                                background: aud-file-touch.has-hover ? #1c2331 : #141923;
                                border-width: 1px;
                                border-color: #334155;
                                border-radius: 6px;

                                Text {
                                    text: "+ File";
                                    color: #94a3b8;
                                    font-size: 11px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                aud-file-touch := TouchArea {
                                    clicked => {
                                        root.add_audio_file();
                                    }
                                }
                            }
                        }
                    }

                    // Divider
                    Rectangle {
                        height: 1px;
                        background: #1b2230;
                    }

                    // SUBTITLES section
                    VerticalLayout {
                        spacing: 8px;

                        HorizontalLayout {
                            alignment: space-between;

                            Text {
                                text: "SUBTITLES";
                                color: #8e9cb0;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            // Unfold / Fold Button
                            Rectangle {
                                height: 22px;
                                background: fold-touch.has-hover ? #1e293b : #141923;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #263043;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 4px;

                                    Text {
                                        text: root.is_folded ? "◨ Unfold" : "◧ Fold";
                                        color: #94a3b8;
                                        font-size: 10px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }

                                fold-touch := TouchArea {
                                    clicked => {
                                        root.toggle_fold();
                                    }
                                }
                            }
                        }

                        // Subtitles Chips Row (Off + Tracks + File)
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            // Off Chip (SINGLE, clean Off, with checkmark when no sub is active)
                            Rectangle {
                                height: 28px;
                                background: root.is_sub_off ? #1e293b : (off-touch.has-hover ? #1c2331 : #141923);
                                border-width: 1px;
                                border-color: root.is_sub_off ? #3b82f6 : #263043;
                                border-radius: 6px;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 6px;
                                    alignment: center;

                                    Text {
                                        text: "Off";
                                        color: root.is_sub_off ? #ffffff : #cbd5e1;
                                        font-size: 11px;
                                        font-weight: root.is_sub_off ? 700 : 500;
                                        vertical-alignment: center;
                                    }

                                    if root.is_sub_off: Text {
                                        text: "✓";
                                        color: #3b82f6;
                                        font-size: 11px;
                                        font-weight: 800;
                                        vertical-alignment: center;
                                    }
                                }

                                off-touch := TouchArea {
                                    clicked => {
                                        root.set_sub_off();
                                    }
                                }
                            }

                            // Subtitle Tracks
                            for track in root.sub_tracks: Rectangle {
                                height: 28px;
                                background: track.is_active ? #1e293b : (sub-item-touch.has-hover ? #1c2331 : #141923);
                                border-width: 1px;
                                border-color: track.is_active ? #3b82f6 : #263043;
                                border-radius: 6px;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 6px;
                                    alignment: center;

                                    Text {
                                        text: track.name;
                                        color: track.is_active ? #ffffff : #cbd5e1;
                                        font-size: 11px;
                                        font-weight: track.is_active ? 700 : 500;
                                        vertical-alignment: center;
                                    }

                                    if track.is_active: Text {
                                        text: "✓";
                                        color: #3b82f6;
                                        font-size: 11px;
                                        font-weight: 800;
                                        vertical-alignment: center;
                                    }
                                }

                                sub-item-touch := TouchArea {
                                    clicked => {
                                        root.select_sub_track(track.id);
                                    }
                                }
                            }

                            // + File Button (Add External Subtitle)
                            Rectangle {
                                width: 56px;
                                height: 28px;
                                background: sub-file-touch.has-hover ? #1c2331 : #141923;
                                border-width: 1px;
                                border-color: #334155;
                                border-radius: 6px;

                                Text {
                                    text: "+ File";
                                    color: #94a3b8;
                                    font-size: 11px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                sub-file-touch := TouchArea {
                                    clicked => {
                                        root.add_sub_file();
                                    }
                                }
                            }
                        }
                    }

                    // UNFOLDED STYLE & TIMING CONTROLS
                    if !root.is_folded: VerticalLayout {
                        spacing: 8px;

                        Rectangle {
                            height: 1px;
                            background: #1b2230;
                        }

                        // Size & Color row
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: space-between;

                            // Size selection
                            HorizontalLayout {
                                spacing: 4px;
                                alignment: start;

                                Text {
                                    text: "Size:";
                                    color: #64748b;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    width: 38px;
                                    height: 22px;
                                    background: root.sub_font_size == 16 ? #1e293b : #141923;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: root.sub_font_size == 16 ? #3b82f6 : #263043;
                                    Text { text: "16px"; color: #cbd5e1; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.set_sub_font_size(16); } }
                                }
                                Rectangle {
                                    width: 38px;
                                    height: 22px;
                                    background: root.sub_font_size == 20 ? #1e293b : #141923;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: root.sub_font_size == 20 ? #3b82f6 : #263043;
                                    Text { text: "20px"; color: #cbd5e1; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.set_sub_font_size(20); } }
                                }
                                Rectangle {
                                    width: 38px;
                                    height: 22px;
                                    background: root.sub_font_size == 24 ? #1e293b : #141923;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: root.sub_font_size == 24 ? #3b82f6 : #263043;
                                    Text { text: "24px"; color: #cbd5e1; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.set_sub_font_size(24); } }
                                }
                            }

                            // Color presets
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: end;

                                Text {
                                    text: "Color:";
                                    color: #64748b;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    background: #ffffff;
                                    border-radius: 10px;
                                    border-width: root.sub_color == "#ffffff" ? 2px : 0px;
                                    border-color: #3b82f6;
                                    TouchArea { clicked => { root.set_sub_color("#ffffff"); } }
                                }
                                Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    background: #fef08a;
                                    border-radius: 10px;
                                    border-width: root.sub_color == "#fef08a" ? 2px : 0px;
                                    border-color: #3b82f6;
                                    TouchArea { clicked => { root.set_sub_color("#fef08a"); } }
                                }
                                Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    background: #67e8f9;
                                    border-radius: 10px;
                                    border-width: root.sub_color == "#67e8f9" ? 2px : 0px;
                                    border-color: #3b82f6;
                                    TouchArea { clicked => { root.set_sub_color("#67e8f9"); } }
                                }
                            }
                        }

                        // Delay / Sync row
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            Text {
                                text: "Sync Delay: " + root.sub_delay_label;
                                color: #64748b;
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                width: 44px;
                                height: 22px;
                                background: #141923;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #263043;
                                Text { text: "-0.5s"; color: #94a3b8; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.adjust_sub_delay(-0.5); } }
                            }
                            Rectangle {
                                width: 44px;
                                height: 22px;
                                background: #141923;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #263043;
                                Text { text: "Reset"; color: #94a3b8; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.adjust_sub_delay(0.0); } }
                            }
                            Rectangle {
                                width: 44px;
                                height: 22px;
                                background: #141923;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #263043;
                                Text { text: "+0.5s"; color: #94a3b8; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { root.adjust_sub_delay(0.5); } }
                            }
                        }
                    }
                }
            }

            // --- RECENT MEDIA HISTORY SLIDE-OVER DRAWER ---
            if show_recent_panel: Rectangle {
                x: parent.width - 320px;
                y: 0px;
                width: 320px;
                height: parent.height;
                background: #0d0d12;
                border-width: 1px;
                border-color: #1f1f2e;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    // Drawer Header
                    HorizontalLayout {
                        alignment: space-between;

                        Text {
                            text: "Media History";
                            color: #ffffff;
                            font-size: 14px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 24px;
                            height: 24px;
                            background: close-hist.has-hover ? #28283a : transparent;
                            border-radius: 12px;

                            Text {
                                text: "✕";
                                color: #a1a1aa;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            close-hist := TouchArea {
                                clicked => { root.close_popovers(); }
                            }
                        }
                    }

                    // History list
                    for item in root.history_items: Rectangle {
                        height: 52px;
                        background: item-touch.has-hover ? #181824 : #12121a;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #1e1e2d;

                        VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 4px;

                            Text {
                                text: item.title;
                                color: #f4f4f5;
                                font-size: 12px;
                                font-weight: 600;
                                overflow: elide;
                            }

                            HorizontalLayout {
                                alignment: space-between;

                                Text {
                                    text: item.time_str;
                                    color: #71717a;
                                    font-size: 10px;
                                }

                                Text {
                                    text: "Resume ▶";
                                    color: #e11d2e;
                                    font-size: 10px;
                                    font-weight: 600;
                                }
                            }
                        }

                        item-touch := TouchArea {
                            clicked => {
                                root.play_history_item(item.id);
                            }
                        }
                    }
                }
            }
        }

        // Bottom Playback Controls Bar (Hidden if hide_overlay is true in embed mode)
        if !(root.player_mode == "embed" && root.hide_overlay): Rectangle {
            height: 68px;
            background: #0a0a0c;
            border-width: 1px;
            border-color: #1a1a22;

            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 6px;
                padding-bottom: 8px;
                spacing: 6px;

                // Scrub / Seekbar
                HorizontalLayout {
                    spacing: 8px;

                    Slider {
                        minimum: 0.0;
                        maximum: 1.0;
                        value: root.progress;
                        changed(val) => { root.seek(val); }
                    }
                }

                // Controls Row
                HorizontalLayout {
                    alignment: space-between;

                    // Play/Pause, Step & Time
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        // Play/Pause Button
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            background: play-area.has-hover ? #e11d2e : #1c1c24;
                            border-radius: 16px;

                            Text {
                                text: root.is_playing ? "❚❚" : "▶";
                                color: #ffffff;
                                font-size: 13px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            play-area := TouchArea {
                                clicked => { root.toggle_play(); }
                            }
                        }

                        // Step Backward -5s
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            background: bwd-area.has-hover ? #282834 : transparent;
                            border-radius: 14px;

                            Text {
                                text: "↺ 5";
                                color: #a1a1aa;
                                font-size: 10px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            bwd-area := TouchArea {
                                clicked => { root.step_backward(); }
                            }
                        }

                        // Step Forward +5s
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            background: fwd-area.has-hover ? #282834 : transparent;
                            border-radius: 14px;

                            Text {
                                text: "5 ↻";
                                color: #a1a1aa;
                                font-size: 10px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            fwd-area := TouchArea {
                                clicked => { root.step_forward(); }
                            }
                        }

                        // Time Display
                        Text {
                            text: root.time_display;
                            color: #a1a1aa;
                            font-size: 12px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                    }

                    // Right Controls: Speed, Audio, Subtitles, Volume
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: end;

                        // Playback Speed Toggle
                        Rectangle {
                            height: 26px;
                            background: #14141c;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #262632;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: root.speed_label;
                                    color: #a1a1aa;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }

                            TouchArea {
                                clicked => { root.toggle_speed(); }
                            }
                        }

                        // Audio Track Chip (Click to open Popover)
                        Rectangle {
                            height: 26px;
                            background: root.show_audio_sub_popover ? #1e293b : #14141c;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: root.show_audio_sub_popover ? #3b82f6 : #263043;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;

                                Text {
                                    text: "Audio: " + root.audio_track_label;
                                    color: #d4d4d8;
                                    font-size: 11px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                            }

                            TouchArea {
                                clicked => { root.toggle_audio_menu(); }
                            }
                        }

                        // Subtitle Track Chip (Click to open Popover)
                        Rectangle {
                            height: 26px;
                            background: root.show_audio_sub_popover ? #1e293b : #14141c;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: root.show_audio_sub_popover ? #3b82f6 : #263043;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;

                                Text {
                                    text: "Subs: " + root.sub_track_label;
                                    color: #d4d4d8;
                                    font-size: 11px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                            }

                            TouchArea {
                                clicked => { root.toggle_sub_menu(); }
                            }
                        }

                        // Mute / Unmute Button
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            background: mute-area.has-hover ? #282834 : #14141c;
                            border-radius: 14px;

                            Text {
                                text: root.volume > 0.0 ? "🔊" : "🔇";
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            mute-area := TouchArea {
                                clicked => { root.toggle_mute(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
