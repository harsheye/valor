# ==============================================================================
# Valor Configuration - Environment Variables
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Docker Compose Project Configuration
# ------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=valor-stack

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# Local Docker default: localhost / valor_postgres
# Test Environment: database1.streamiteasy.xyz
# ------------------------------------------------------------------------------
POSTGRES_HOST=database1.streamiteasy.xyz
POSTGRES_PORT=5432
POSTGRES_DB=valor
POSTGRES_USER=valor_user
POSTGRES_PASSWORD=ValorPass2026!
DATABASE_URL=postgresql://valor_user:ValorPass2026!@database1.streamiteasy.xyz:5432/valor

# ------------------------------------------------------------------------------
# Redis Cache Configuration
# Local Docker default: localhost / valor_redis
# Test Environment: redis.streamiteasy.xyz
# ------------------------------------------------------------------------------
REDIS_HOST=redis.streamiteasy.xyz
REDIS_PORT=6379
REDIS_USER=admin
REDIS_PASSWORD=AdminPass2026!
REDIS_URL=redis://admin:AdminPass2026!@redis.streamiteasy.xyz:6379

# ------------------------------------------------------------------------------
# Legacy Compatibility Aliases
# ------------------------------------------------------------------------------
DB_HOST=database1.streamiteasy.xyz
DB_PORT=5432
DB_USERNAME=valor_user
DB_PASSWORD=ValorPass2026!
DB_DATABASE_NAME=valor
UPLOAD_LOCATION=./library
DB_DATA_LOCATION=./postgres

# ------------------------------------------------------------------------------
# Frontend / Client Environment Variables (Exposed via Vite - prefix with VITE_)
# ------------------------------------------------------------------------------
# TMDB API Bearer Token (v4 Auth) or API Key (v3) for movie/series metadata and poster search
VITE_TMDB_BEARER_TOKEN=
VITE_TMDB_API_KEY=

# Trakt.tv OAuth Application Client ID for history scrobbling and watchlist sync
VITE_TRAKT_CLIENT_ID=

# Optional: OpenSubtitles.com API Key for automatic subtitle fetching
VITE_OPENSUBTITLES_API_KEY=

# ------------------------------------------------------------------------------
# Server / Local Engine Configuration
# ------------------------------------------------------------------------------
# Host interface to bind backend and service server (default: 127.0.0.1 for security)
HOST=127.0.0.1

# HTTP Service Server port (default: 80, or 3000 if non-root on Linux/macOS)
PORT_SERVICE=80

# Valor Local Engine backend API port (default: 50001)
PORT_BACKEND=50001

# Logging mode: 'release' (quiet, logs only startup and errors) or 'developer' (verbose)
VALOR_LOG_MODE=release

# Debug flag: 'true' enables detailed demuxer, buffer, and scheduler traces
DEBUG=false
