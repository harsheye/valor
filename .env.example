# ==============================================================================
# Valor Configuration - Environment Variables
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend / Client Environment Variables (Exposed via Vite - prefix with VITE_)
# ------------------------------------------------------------------------------
# TMDB API Bearer Token (v4 Auth) or API Key (v3) for movie/series metadata and poster search
VITE_TMDB_BEARER_TOKEN=
VITE_TMDB_API_KEY=

# Trakt.tv OAuth Application Client ID for history scrobbling and watchlist sync
VITE_TRAKT_CLIENT_ID=

# Optional: OpenSubtitles.com API Key for automatic subtitle fetching
VITE_OPENSUBTITLES_API_KEY=

# ------------------------------------------------------------------------------
# Server / Local Engine Configuration
# ------------------------------------------------------------------------------
# Host interface to bind backend and service server (default: 127.0.0.1 for security)
HOST=127.0.0.1

# HTTP Service Server port (default: 80, or 3000 if non-root on Linux/macOS)
PORT_SERVICE=80

# Valor Local Engine backend API port (default: 50001)
PORT_BACKEND=50001

# Logging mode: 'release' (quiet, logs only startup and errors) or 'developer' (verbose)
VALOR_LOG_MODE=release

# Debug flag: 'true' enables detailed demuxer, buffer, and scheduler traces
DEBUG=false

# ------------------------------------------------------------------------------
# Optional Database / Immich Integration (if running external sync)
# ------------------------------------------------------------------------------
UPLOAD_LOCATION=./library
DB_DATA_LOCATION=./postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE_NAME=immich
