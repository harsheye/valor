<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.valor.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/Users/leetwhitesnake/Valor/valor/start-app.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/leetwhitesnake/Valor/valor</string>

