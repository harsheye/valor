{
  "manifest_version": 3,
  "name": "Valor Auto-Embed",
  "version": "1.0.0",
  "description": "Automatically replaces online video players with the Valor embed player.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Valor Settings"
  },
  "web_accessible_resources": [
    {
      "resources": ["embed.html", "embed.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
