{
  "id": "youtube",
  "name": "YouTube Player",
  "author": "Valor Team",
  "version": "1.0.0",
  "description": "Sleek dark player UI inspired by YouTube: left-aligned play/skip/volume/time controls, right-aligned Auto-Next toggle, Subtitles, Settings gear (Speed, Audio, Subtitles, Aspect, Ambient Mode, HDR Boost), PiP, and Fullscreen.",
  "colors": {
    "window_bg": "#0F0F0F",
    "chrome_bg": "#0F0F0F",
    "nav_surface": "#0F0F0F",
    "content_surface": "#0F0F0F",
    "card_fill": "#1F1F1F",
    "field_fill": "#272727",
    "accent": "#FF0033",
    "accent_hover": "#FF3355",
    "text_primary": "#FFFFFF",
    "text_secondary": "#AAAAAA",
    "text_tertiary": "#717171",
    "divider": "#272727",
    "player_bar_bg": "#0F0F0FE6",
    "scrubber_fill": "#3EA6FF",
    "scrubber_track": "#FFFFFF4D",
    "scrubber_knob": "#3EA6FF"
  },
  "shell_layout": {
    "nav_position": "left_sidebar",
    "nav_width": 240.0,
    "content_corner_radius": 8,
    "card_corner_radius": 10,
    "show_hero_banner": true,
    "mini_bar_position": "bottom",
    "titlebar_style": "modern",
    "loading_spinner": "blue_circle",
    "hover_card_style": "default"
  },
  "player_layout": {
    "style": "youtube",
    "controls_position": "bottom",
    "scrubber_position": "above_controls",
    "transport_align": "left",
    "show_title_top": true,
    "show_edge_arrows": false,
    "bar_height": 84.0,
    "bar_corner_radius": 0,
    "bar_margin_x": 0.0,
    "bar_margin_bottom": 0.0,
    "scrubber_height": 4.0,
    "play_button_style": "icon",
    "popup_style": "youtube_settings",
    "loading_spinner": "blue_circle",
    "left_controls": ["play", "skip_back", "skip_forward", "volume", "time", "title"],
    "center_controls": [],
    "right_controls": ["auto_next", "hdr_boost", "subtitles", "settings", "pip", "fullscreen"]
  }
}
