{
  "id": "netflix",
  "name": "Netflix",
  "author": "Valor Team",
  "version": "1.0.0",
  "description": "Cinematic streaming UI inspired by Netflix: horizontal top navigation bar, hover preview cards, red arc loading spinner, red scrubber, dual-column Audio & Subtitles popup, and horizontal speed slider.",
  "colors": {
    "window_bg": "#141414",
    "chrome_bg": "#0B0B0B",
    "nav_surface": "#141414",
    "content_surface": "#141414",
    "card_fill": "#1F1F1F",
    "field_fill": "#222222",
    "accent": "#E50914",
    "accent_hover": "#F40612",
    "text_primary": "#FFFFFF",
    "text_secondary": "#D2D2D2",
    "text_tertiary": "#8C8C8C",
    "divider": "#2A2A2A",
    "player_bar_bg": "#0A0A0AE0",
    "scrubber_fill": "#E50914",
    "scrubber_track": "#4D4D4D",
    "scrubber_knob": "#E50914"
  },
  "shell_layout": {
    "nav_position": "top_navbar",
    "nav_width": 240.0,
    "content_corner_radius": 0,
    "card_corner_radius": 6,
    "show_hero_banner": true,
    "mini_bar_position": "bottom",
    "titlebar_style": "modern",
    "loading_spinner": "red_arc",
    "hover_card_style": "netflix_preview"
  },
  "player_layout": {
    "style": "netflix",
    "controls_position": "bottom",
    "scrubber_position": "above_controls",
    "transport_align": "left",
    "show_title_top": true,
    "show_edge_arrows": true,
    "bar_height": 108.0,
    "bar_corner_radius": 0,
    "bar_margin_x": 0.0,
    "bar_margin_bottom": 0.0,
    "scrubber_height": 5.0,
    "play_button_style": "icon",
    "popup_style": "netflix_dual_tracks",
    "loading_spinner": "red_arc",
    "left_controls": ["play", "skip_back", "skip_forward", "volume"],
    "center_controls": ["title"],
    "right_controls": ["next_episode", "queue", "subtitles", "speed", "hdr_boost", "pip", "fullscreen"]
  }
}
